    "worker": "node --import tsx server/main.js worker",
    "demo:saved": "node --import tsx scripts/saved-demo.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@dagrejs/dagre": "^3.1.3",
    "@google/genai": "^1.30.0",
    "@xyflow/react": "^12.12.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "pg-mem": "^3.0.14",
    "typescript": "^7.0.2",
    "vite": "^7.2.0"
  }
