# Copy to .env.pilot; never commit real values. Use random hex secrets (not these placeholders).
POSTGRES_PASSWORD=replace-with-random-hex
SESSION_SECRET=replace-with-at-least-32-random-characters
SERVICE_CREDENTIALS=[{"org":"pilot-company","key":"replace-with-another-32-character-random-secret"}]
APP_ORIGIN=http://localhost:8080
# Exact parent origins allowed to embed and exchange session messages; no wildcards.
EMBED_ORIGINS=http://localhost:3000
BRAND_NAME=MICAWS
AI_PROVIDER=mock
ALLOW_EXTERNAL_AI=false
AI_DAILY_CALL_LIMIT=2000
WORKER_CONCURRENCY=2
RETENTION_DAYS=30
# Needed outside Compose:
# DATABASE_URL=postgresql://micaws:password@localhost:5432/micaws
# For Gemini explicitly approve processing and choose models enabled for your key:
# ALLOW_EXTERNAL_AI=true
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_MODELS=
# For local Ollama on Docker Desktop:
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b
# Optional private, encrypted S3-compatible storage. Bucket must not be public.
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PATH_STYLE=true
